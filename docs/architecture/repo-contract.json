{
  "project": "romanbediner.com",
  "deployment_model": "github-pages-static",
  "branches": {
    "staging": "preview validation and integration branch",
    "prod": "production deployment branch"
  },
  "critical_files": [
    ".github/workflows/ci.yml",
    ".github/workflows/deploy-pages.yml",
    ".github/workflows/deploy-staging.yml",
    ".github/workflows/rollback.yml",
    "scripts/qa/verify-session-readiness.js",
    "scripts/qa/verify-repo-contract.js",
    "scripts/qa/verify-workflow-integrity.js",
    "scripts/build/create-artifact.js",
    "scripts/qa/verify-artifact-integrity.js",
    "scripts/build/create-preview-artifact.js",
    "scripts/qa/verify-preview-artifact.js",
    "scripts/release/publish-preview-repo.js"
  ],
  "protected_paths": [
    ".github/workflows",
    "docs/architecture",
    "scripts/qa",
    "scripts/build",
    "scripts/release",
    "scripts/docs"
  ],
  "required_scripts": [
    "session:ready",
    "docs:generate",
    "docs:verify",
    "test:node",
    "test:python",
    "test:jest",
    "test:playwright"
  ],
  "release_policy": {
    "staging_first": true,
    "assistant_auto_pushes_staging_after_local_pass": true,
    "staging_tests_must_pass_before_preview_confirmation": true,
    "preview_url_must_be_shared_with_pass_confirmation": true,
    "prod_promotion_requires_visual_signoff": true
  }
}
